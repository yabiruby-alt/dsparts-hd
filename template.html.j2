          <span class="lbl">당일 입고 재고조사 리스트</span>
          <span class="val">{{ stockcheck.count }}건</span>
          <span class="foot">{{ stockcheck.date }} 입고 · 현재고 0(출고완료) 제외 · LOCATION 오름차순 · 인쇄해서 실수량 기재</span>
        </div>
        <div class="tablewrap">
          <table class="stockcheck-table">
            <thead><tr><th class="num">NO.</th><th>LOCATION</th><th>부품번호</th><th>부품명</th><th class="num">현재고</th><th class="num chk">실수량</th></tr></thead>
            <tbody>
              {% for r in stockcheck.rows %}
              <tr><td class="num">{{ r.no }}</td><td class="mono">{{ r.loc }}</td><td class="mono">{{ r.item }}</td><td>{{ r.name }}</td><td class="num">{{ r.qty }}</td><td class="num chk"></td></tr>
              {% else %}
              <tr><td colspan="6" class="empty-note">오늘 입고된 부품 중 현재고가 남아있는 품목 없음</td></tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section id="page-stockcheckweek" hidden>
      <div class="crumbbar">
        <span class="crumb">동성모터스 PARTS &nbsp;›&nbsp; <b>주간 재고조사</b></span>
        <div class="spacer"></div>
        <div class="freshness"><span class="dot"></span>{{ meta.branch_name }} · {{ stockcheck_week.start }} ~ {{ stockcheck_week.end }} 출고분</div>
      </div>

      <div class="viewer">
        <div class="viewer-head">
          <span class="lbl">주간 출고 재고조사 리스트</span>
          <span class="val">{{ stockcheck_week.count }}건</span>
          <span class="foot">지난주 {{ stockcheck_week.start }} ~ {{ stockcheck_week.end }}(월~토) 출고 · 현재고 0 제외 · LOCATION 오름차순 · 인쇄해서 실수량 기재</span>
        </div>
        <div class="tablewrap">
          <table class="stockcheck-table">
            <thead><tr><th class="num">NO.</th><th>LOCATION</th><th>부품번호</th><th>부품명</th><th class="num">현재고</th><th class="num chk">실수량</th></tr></thead>
            <tbody>
              {% for r in stockcheck_week.rows %}
              <tr><td class="num">{{ r.no }}</td><td class="mono">{{ r.loc }}</td><td class="mono">{{ r.item }}</td><td>{{ r.name }}</td><td class="num">{{ r.qty }}</td><td class="num chk"></td></tr>
              {% else %}
              <tr><td colspan="6" class="empty-note">지난주 출고된 부품 중 현재고가 남아있는 품목 없음</td></tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section id="page-calendar" hidden>
      <div class="crumbbar">
        <span class="crumb">동성모터스 PARTS &nbsp;›&nbsp; <b>팀 캘린더</b></span>
        <div class="spacer"></div>
        <div class="freshness"><span class="dot"></span>{{ meta.branch_name }}</div>
      </div>

      <div class="viewer" style="padding:0; overflow:hidden;">
        {% if meta.calendar_image %}
        <img src="{{ meta.calendar_image }}" alt="팀 캘린더" style="display:block; width:100%; height:auto;">
        {% else %}
        <div class="empty-note" style="padding:40px 22px;">팀 캘린더 이미지가 아직 없습니다. docs 폴더에 "team-calendar.jpg"(또는 .png) 파일을 넣어주시면 다음 갱신 때 자동으로 표시됩니다.</div>
        {% endif %}
      </div>
    </section>
    </div>
  </main>
</div>

<script>
  function selectKpi(key){ ['recv','inv'].forEach(k=>{ document.getElementById('detail-'+k).hidden=(k!==key); document.getElementById('tile-'+k).setAttribute('aria-pressed', String(k===key)); }); }
  function selectExtKpi(key){ ['ext','shop'].forEach(k=>{ document.getElementById('detail-'+k).hidden=(k!==key); document.getElementById('tile-'+k).setAttribute('aria-pressed', String(k===key)); }); }
  function selectAccKpi(key){ ['acc','tire'].forEach(k=>{ document.getElementById('detail-'+k).hidden=(k!==key); document.getElementById('tile-'+k).setAttribute('aria-pressed', String(k===key)); }); }
  function selectLongKpi(key){ ['m12','m24'].forEach(k=>{ document.getElementById('detail-'+k).hidden=(k!==key); document.getElementById('tile-'+k).setAttribute('aria-pressed', String(k===key)); }); }
  var PAGES = ['today','openro','noshow','sbresv','sbcar','external','accessory','oaov','longstock','nonmng','stockcheck','stockcheckweek','opart','oflow','calendar'];
  function selectPage(key){
    PAGES.forEach(k=>{ document.getElementById('page-'+k).hidden=(k!==key); document.getElementById('nav-'+k).setAttribute('aria-current', k===key?'page':'false'); });
    document.querySelector('.maininner').classList.toggle('wide', key==='calendar');
    try{ sessionStorage.setItem('dsparts-page', key); }catch(e){}
    var nb = document.getElementById('nav-'+key), mt = document.getElementById('m-title');
    if(nb && mt){ mt.textContent = nb.textContent.replace(/\s+/g,' ').trim(); }
    if(nb){ var sc = nb.closest('.sb-section'); if(sc && sc.classList.contains('collapsed')) toggleSection(sc, true); }
    document.body.classList.remove('menu-open');
    window.scrollTo(0,0);
  }
  function toggleSection(sec, force){
    var c = (force===undefined) ? !sec.classList.contains('collapsed') : !force;
    sec.classList.toggle('collapsed', c);
    var b = sec.querySelector('.sb-label'); if(b) b.setAttribute('aria-expanded', c?'false':'true');
    try{
      var st = JSON.parse(localStorage.getItem('dsparts-collapsed')||'{}');
      st[b.firstChild.textContent.trim()] = c; localStorage.setItem('dsparts-collapsed', JSON.stringify(st));
    }catch(e){}
  }
  (function(){
    try{
      var st = JSON.parse(localStorage.getItem('dsparts-collapsed')||'{}');
      document.querySelectorAll('.sb-section').forEach(function(sec){
        var b = sec.querySelector('.sb-label');
        if(b && st[b.firstChild.textContent.trim()]) toggleSection(sec, false);
      });
    }catch(e){}
  })();
  document.querySelectorAll('.sb-section').forEach(function(sec){
    var b = sec.querySelector('.sb-label'), n = sec.querySelectorAll('.sb-item').length;
    if(b && n){ var c = document.createElement('span'); c.className='cnt'; c.textContent=n; b.insertBefore(c, b.querySelector('.chev')); }
  });
  function toggleMenu(force){ document.body.classList.toggle('menu-open', force); }
  // 현재 화면의 표들을 엑셀(.xlsx)로 저장 (접힌 그룹 안 행 + 진행RO 사유 포함)
  function exportExcel(){
    var sec = PAGES.map(function(k){ return document.getElementById('page-'+k); }).filter(function(e){ return !e.hidden; })[0];
    var tables = sec ? sec.querySelectorAll('table:not(.partsub)') : [];
    if(!tables.length){ alert('이 화면에는 저장할 표가 없습니다.'); return; }
    function run(){
      var wb = XLSX.utils.book_new(), used = {};
      tables.forEach(function(t, idx){
        var rows = [];
        t.querySelectorAll('tr').forEach(function(tr){
          if(tr.closest('table') !== t) return;
          var sub = tr.querySelector('table.partsub');
          if(sub){
            sub.querySelectorAll('tr').forEach(function(sr){
              var pl = ['  ↳'];
              sr.querySelectorAll('th,td').forEach(function(c){
                var v = c.textContent.replace(/\s+/g,' ').trim();
                if(c.classList.contains('num') && /^-?[\d,]+$/.test(v)){ v = Number(v.replace(/,/g,'')); }
                pl.push(v);
              });
              rows.push(pl);
            });
            return;
          }
          var line = [];
          tr.querySelectorAll('th,td').forEach(function(c){
            var v;
            var rc = c.querySelector('.reason-cell');
            if(rc){ v = rc.getAttribute('data-saved') || ''; }
            else {
              v = c.textContent.replace(/\s+/g,' ').trim().replace(/^▸\s*/, '');
              if(c.classList.contains('num') && /^-?[\d,]+(\.\d+)?%?$/.test(v) && v.indexOf('%')<0){ v = Number(v.replace(/,/g,'')); }
            }
            line.push(v);
            for(var i=1;i<(parseInt(c.getAttribute('colspan'))||1);i++) line.push('');
          });
          rows.push(line);
        });
        var host = t.closest('.viewer') || t.parentNode;
        var lblEl = host.querySelector('.viewer-head .lbl') || host.querySelector('.subttl');
        var name = (lblEl ? lblEl.textContent : ('표'+(idx+1))).replace(/[:*?\/\\\[\]]/g,' ').replace(/\s+/g,' ').trim().slice(0,28) || ('표'+(idx+1));
        if(used[name]){ name = name.slice(0,25) + '_' + (++used[name]); } else { used[name] = 1; }
        var ws = XLSX.utils.aoa_to_sheet(rows);
        var widths = [];
        rows.forEach(function(r){ r.forEach(function(v,i){ var l = String(v).length; widths[i] = Math.min(60, Math.max(widths[i]||8, l+2)); }); });
        ws['!cols'] = widths.map(function(w){ return {wch:w}; });
        XLSX.utils.book_append_sheet(wb, ws, name);
      });
      var title = (sec.querySelector('.crumb b') || {textContent:'화면'}).textContent.trim();
      var d = new Date(); var ymd = d.getFullYear() + String(d.getMonth()+1).padStart(2,'0') + String(d.getDate()).padStart(2,'0');
      XLSX.writeFile(wb, '동성모터스_' + title + '_' + ymd + '.xlsx');
    }
    if(window.XLSX){ run(); return; }
    var sc = document.createElement('script');
    sc.src = 'https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js';
    sc.onload = run;
    sc.onerror = function(){ alert('엑셀 변환 라이브러리를 불러오지 못했습니다. 인터넷 연결을 확인해주세요.'); };
    document.head.appendChild(sc);
  }

  // 10분 자동새로고침 후에도 보던 화면 유지
  try{ var savedPage = sessionStorage.getItem('dsparts-page'); if(savedPage && PAGES.indexOf(savedPage)>=0 && savedPage!=='today'){ selectPage(savedPage); } }catch(e){}

  // 진행RO 경과일: 30일 이상은 붉은색, 오래될수록 진하게
  document.querySelectorAll('.dday-cell').forEach(function(td){
    var d = parseInt(td.getAttribute('data-days'), 10);
    if(isNaN(d) || d < 30) return;
    var a = Math.min(0.9, 0.10 + (d - 30) / 300 * 0.8);
    td.style.background = 'rgba(208,52,44,' + a.toFixed(2) + ')';
    td.style.color = a > 0.5 ? '#fff' : '#b02a22';
    td.style.fontWeight = '700';
  });

  // 진행RO 사유: 대시보드 PC(로컬 서버가 켜져 있는 곳)에서만 입력/수정, 그 외 기기는 조회 전용
  (function(){
    var API = '';
    var cells = document.querySelectorAll('.reason-cell');
    if(!cells.length) return;
    // 사유 편집은 대시보드 PC의 로컬 주소(http://127.0.0.1:8765)로 접속했을 때만 활성화. 그 외(깃허브 주소/폰)는 조회 전용.
    if(!((location.hostname === '127.0.0.1' || location.hostname === 'localhost') && location.port === '8765')) return;
    function el(tag, cls, txt){ var e = document.createElement(tag); if(cls) e.className = cls; if(txt != null) e.textContent = txt; return e; }
    function render(cell, editing){
      var saved = cell.getAttribute('data-saved') || '';
      cell.innerHTML = '';
      if(!editing && saved){
        cell.appendChild(el('span', 'reason-text', saved));
        var eb = el('button', 'rbtn', '수정'); eb.type = 'button';
        eb.onclick = function(){ render(cell, true); };
        cell.appendChild(eb);
        return;
      }
      var inp = el('input', 'reason-input'); inp.type = 'text'; inp.value = saved; inp.placeholder = '사유 입력'; inp.maxLength = 300;
      var sb = el('button', 'rbtn rbtn-primary', '저장'); sb.type = 'button';
      var msg = el('span', 'rmsg', '');
      function doSave(){
        var v = inp.value.trim(), ro = cell.getAttribute('data-ro'), body = {}; body[ro] = v;
        sb.disabled = true; msg.textContent = '저장 중...';
        fetch(API + '/reasons', {method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({set: body})})
          .then(function(r){ if(!r.ok) throw new Error('save'); return r.json(); })
          .then(function(){ cell.setAttribute('data-saved', v); render(cell, false); })
          .catch(function(){ sb.disabled = false; msg.textContent = '저장 실패 (대시보드 프로그램이 켜져 있는지 확인)'; });
      }
      sb.onclick = doSave;
      inp.addEventListener('keydown', function(e){ if(e.key === 'Enter'){ doSave(); } });
      cell.appendChild(inp); cell.appendChild(sb);
      if(saved){ var cb = el('button', 'rbtn', '취소'); cb.type = 'button'; cb.onclick = function(){ render(cell, false); }; cell.appendChild(cb); }
      cell.appendChild(msg);
    }
    function enable(){
      fetch(API + '/reasons').then(function(r){ return r.json(); }).then(function(server){
        var mig = {}, local = {};
        try{ local = JSON.parse(localStorage.getItem('dsparts-ro-reasons') || '{}'); }catch(e){}
        cells.forEach(function(c){
          var ro = c.getAttribute('data-ro');
          if(server[ro] != null){ c.setAttribute('data-saved', server[ro]); }
          else if(local[ro]){ mig[ro] = local[ro]; c.setAttribute('data-saved', local[ro]); }
          else { c.setAttribute('data-saved', ''); }
        });
        if(Object.keys(mig).length){
          fetch(API + '/reasons', {method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({set: mig})})
            .then(function(r){ if(r.ok){ try{ localStorage.removeItem('dsparts-ro-reasons'); }catch(e){} } });
        }
        cells.forEach(function(c){ render(c, false); });
      }).catch(function(){});
    }
    fetch(API + '/ping').then(function(r){ if(r.ok) enable(); }).catch(function(){});
  })();
  function toggleAloisGroup(headEl){
    var key = headEl.getAttribute('data-group');
    var table = headEl.closest('table');
    var open = !headEl.classList.contains('open');
    headEl.classList.toggle('open', open);
    table.querySelectorAll('tr[data-group="'+key+'"]').forEach(function(tr){
      if(tr===headEl) return;
      if(tr.classList.contains('partsrow')){ tr.hidden = !(open && tr.previousElementSibling && tr.previousElementSibling.classList.contains('open')); }
      else { tr.hidden = !open; }
    });
    if(!open){ table.querySelectorAll('tr.coderow[data-group="'+key+'"]').forEach(function(t){ t.classList.remove('open'); }); }
  }
  function toggleCodeRow(tr){
    tr.classList.toggle('open');
    var d = tr.nextElementSibling;
    if(d && d.classList.contains('partsrow')){ d.hidden = !tr.classList.contains('open'); }
  }
</script>
</body>
</html>
