<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<!-- 백엔드가 10분마다 갱신하므로, 켜둔 화면도 같은 주기로 자동 새로고침 -->
<meta http-equiv="refresh" content="600">
<title>동성모터스 PARTS</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@500;600;700&display=swap');

  :root{
    color-scheme: light;
    --page:#f5f5f7; --surface:#ffffff; --surface-2:#f5f5f7; --sidebar:#fbfbfd;
    --line:#e5e5ea; --ink:#1d1d1f; --ink-2:#48484a; --muted:#86868b;
    --accent:#0066b1; --accent-strong:#004d8a; --accent-wash:#eaf3fb;
    --m-blue:#1e5aa8; --m-violet:#5a287d; --m-red:#e2231a;
    --good:#1fa34d; --critical:#d0342c; --critical-wash:#fdeeed;
    --font-display:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',system-ui,sans-serif;
    --font-body:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',system-ui,sans-serif;
    --font-mono:'IBM Plex Mono',ui-monospace,'SF Mono','SFMono-Regular',Menlo,monospace;
    --shadow-sm: 0 1px 2px rgba(0,0,0,.04), 0 1px 10px rgba(0,0,0,.035);
    --shadow-md: 0 4px 10px rgba(0,0,0,.05), 0 10px 28px rgba(0,0,0,.06);
    --shadow-card: 0 0 0 1px rgba(0,0,0,.04), 0 1px 2px rgba(0,0,0,.04), 0 8px 20px rgba(0,0,0,.04);
  }
  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]){
      color-scheme: dark;
      --page:#000000; --surface:#1c1c1e; --surface-2:#242426; --sidebar:#111113;
      --line:#333335; --ink:#f5f5f7; --ink-2:#c7c7cc; --muted:#8e8e93;
      --accent:#409cff; --accent-strong:#8ec3f2; --accent-wash:#122236;
      --m-blue:#3f7fc7; --m-violet:#8a5aae; --m-red:#ff5b47;
      --good:#30d158; --critical:#e2695c; --critical-wash:#301715;
      --shadow-sm: 0 1px 2px rgba(0,0,0,.3), 0 1px 10px rgba(0,0,0,.25);
      --shadow-md: 0 4px 10px rgba(0,0,0,.35), 0 10px 28px rgba(0,0,0,.35);
      --shadow-card: 0 0 0 1px rgba(255,255,255,.06), 0 8px 20px rgba(0,0,0,.35);
    }
  }
  :root[data-theme="dark"]{
    color-scheme: dark;
    --page:#000000; --surface:#1c1c1e; --surface-2:#242426; --sidebar:#111113;
    --line:#333335; --ink:#f5f5f7; --ink-2:#c7c7cc; --muted:#8e8e93;
    --accent:#409cff; --accent-strong:#8ec3f2; --accent-wash:#122236;
    --m-blue:#3f7fc7; --m-violet:#8a5aae; --m-red:#ff5b47;
    --good:#30d158; --critical:#e2695c; --critical-wash:#301715;
    --shadow-sm: 0 1px 2px rgba(0,0,0,.3), 0 1px 10px rgba(0,0,0,.25);
    --shadow-md: 0 4px 10px rgba(0,0,0,.35), 0 10px 28px rgba(0,0,0,.35);
    --shadow-card: 0 0 0 1px rgba(255,255,255,.06), 0 8px 20px rgba(0,0,0,.35);
  }

  *{box-sizing:border-box;}
  html, body{ height:100%; margin:0; }
  body{ background:var(--page); color:var(--ink); font-family:var(--font-body);
    -webkit-font-smoothing:antialiased; text-rendering:optimizeLegibility; }

  .app{ display:flex; height:100%; min-height:100vh; }

  /* ============ SIDEBAR ============ */
  .sidebar{ width:256px; flex:none; background:var(--sidebar); box-shadow:inset -1px 0 0 var(--line);
    display:flex; flex-direction:column; padding:22px 16px; gap:22px; overflow-y:auto; }
  .sb-brand{ display:flex; align-items:center; gap:10px; padding:4px 8px; cursor:pointer; border-radius:10px; transition:background .12s ease; }
  .sb-brand:hover{ background:var(--surface-2); }
  .sb-brand .mark{ width:30px; height:30px; border-radius:9px; background:var(--accent); color:#fff; flex:none;
    display:flex; align-items:center; justify-content:center; font-family:var(--font-mono); font-weight:700; font-size:13.5px; box-shadow:var(--shadow-sm); }
  .sb-brand .name{ font-family:var(--font-display); font-weight:700; font-size:18.5px; letter-spacing:-.015em; }
  .sb-mstripe{ height:2px; border-radius:2px; margin:-10px 8px 0; opacity:.85;
    background:linear-gradient(90deg, var(--m-blue) 0 33.33%, var(--m-violet) 33.33% 66.66%, var(--m-red) 66.66% 100%); }

  .sb-workspace{ display:flex; align-items:center; gap:10px; padding:10px 12px; background:var(--surface-2); border-radius:12px; }
  .sb-workspace .ico{ width:26px; height:26px; border-radius:8px; background:var(--surface); flex:none; display:flex; align-items:center; justify-content:center; color:var(--ink-2); box-shadow:var(--shadow-sm); }
  .sb-workspace .tt{ display:flex; flex-direction:column; line-height:1.25; min-width:0; }
  .sb-workspace .tt b{ font-size:14.5px; font-weight:600; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .sb-workspace .tt span{ font-size:12.5px; color:var(--muted); font-family:var(--font-mono); }

  .sb-print{ all:unset; box-sizing:border-box; display:flex; align-items:center; justify-content:center; gap:8px;
    padding:9px 12px; border-radius:10px; background:var(--surface-2); font-family:var(--font-body); font-weight:600;
    font-size:13.5px; color:var(--ink-2); cursor:pointer; transition:background .12s ease, color .12s ease; }
  .sb-tools{ display:flex; flex-direction:column; gap:8px; }
  .sb-print:hover{ background:var(--accent-wash); color:var(--accent-strong); }
  .sb-print svg{ flex:none; opacity:.85; }

  .sb-section{ display:flex; flex-direction:column; gap:2px; }
  .sb-label{ font-family:var(--font-display); font-weight:600; font-size:11.5px; text-transform:uppercase; letter-spacing:.06em; color:var(--muted); padding:0 12px; margin-bottom:6px; }
  .sb-item{ all:unset; box-sizing:border-box; display:flex; align-items:center; gap:10px; padding:8.5px 12px; border-radius:10px; font-size:14.5px; font-weight:500; color:var(--ink-2); cursor:pointer; transition:background .12s ease, color .12s ease; }
  .sb-item svg{ flex:none; opacity:.8; }
  .sb-item:hover{ background:var(--surface-2); color:var(--ink); }
  .sb-item[aria-current="page"]{ background:var(--accent-wash); color:var(--accent-strong); font-weight:600; }
  .sb-item[aria-current="page"] svg{ opacity:1; }
  .sb-item.soon{ cursor:default; }
  .sb-item.soon:hover{ background:transparent; color:var(--ink-2); }
  .sb-item.soon .tag{ margin-left:auto; font-family:var(--font-mono); font-size:11px; color:var(--muted); background:var(--surface-2); border-radius:6px; padding:1px 6px; }

  .sb-spacer{ flex:1 1 auto; }
  .sb-foot{ font-family:var(--font-mono); font-size:12px; color:var(--muted); padding:0 12px; }

  /* ============ MAIN ============ */
  .main{ flex:1 1 auto; min-width:0; overflow-y:auto; height:100%; }
  .maininner{ max-width:none; margin:0 auto; padding:28px 40px 72px; display:flex; flex-direction:column; gap:22px; transition:max-width .15s ease; }
  .maininner.wide{ max-width:none; }

  .crumbbar{ display:flex; align-items:center; gap:8px; }
  .crumb{ font-size:15.5px; color:var(--muted); }
  .crumb b{ color:var(--ink); font-weight:600; }
  .crumbbar .spacer{ flex:1 1 auto; }
  .freshness{ display:flex; align-items:center; gap:7px; font-family:var(--font-mono); font-size:13.5px; color:var(--ink-2); }
  .dot{ width:7px; height:7px; border-radius:50%; background:var(--good); box-shadow:0 0 0 3px rgba(31,163,77,.16); }

  .kpistrip{ display:flex; gap:14px; flex-wrap:wrap; }
  .kpitile{ all:unset; box-sizing:border-box; flex:1 1 240px; cursor:pointer;
    background:var(--surface); border-radius:18px; padding:18px 20px; box-shadow:var(--shadow-card);
    display:flex; flex-direction:column; gap:6px; transition:box-shadow .18s ease, transform .18s ease; }
  .kpitile:hover{ box-shadow:var(--shadow-md); transform:translateY(-1px); }
  .kpitile:focus-visible{ outline:2px solid var(--accent); outline-offset:2px; }
  .kpitile[aria-pressed="true"]{ box-shadow:0 0 0 2px var(--accent), var(--shadow-md); background:var(--accent-wash); }
  .kpitile .rank{ font-family:var(--font-mono); font-size:12px; color:var(--muted); }
  .kpitile .eyebrow{ font-family:var(--font-display); font-weight:600; font-size:15.5px; letter-spacing:-.005em; color:var(--ink-2); }
  .kpitile .value{ font-family:var(--font-mono); font-weight:700; font-variant-numeric:tabular-nums; letter-spacing:-.02em; font-size:34px; color:var(--ink); }
  .kpitile .foot{ font-size:14.5px; color:var(--muted); }
  .kpitile .tapln{ font-family:var(--font-body); font-weight:600; font-size:12.5px; color:var(--accent); margin-top:2px; }

  .viewer{ background:var(--surface); border-radius:18px; padding:24px 26px; box-shadow:var(--shadow-card); }
  .viewer-head{ display:flex; align-items:baseline; gap:10px; margin-bottom:18px; padding-bottom:16px; border-bottom:1px solid var(--line); flex-wrap:wrap; }
  .viewer-head .lbl{ font-family:var(--font-display); font-weight:700; font-size:20px; letter-spacing:-.01em; }
  .viewer-head .val{ font-family:var(--font-mono); font-weight:700; font-size:20px; color:var(--ink); font-variant-numeric:tabular-nums; }
  .viewer-head .foot{ font-size:14.5px; color:var(--muted); margin-left:auto; }

  .subgrid{ display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:18px; }

  .tablewrap{ overflow-x:auto; }
  table{ width:100%; border-collapse:collapse; font-size:15.5px; }
  thead th{ text-align:left; font-family:var(--font-body); font-weight:600; font-size:13px; text-transform:none; letter-spacing:0;
    color:var(--muted); padding:0 10px 9px; border-bottom:1px solid var(--line); white-space:nowrap; }
  tbody td{ padding:9px 10px; border-bottom:1px solid var(--line); white-space:nowrap; }
  .reason-input{ width:280px; max-width:100%; box-sizing:border-box; border:1px solid var(--line); border-radius:8px; padding:6px 10px;
    font:inherit; font-size:13.5px; background:var(--surface); color:var(--ink); transition:border-color .12s ease, box-shadow .12s ease; }
  .dday-badge{ display:inline-block; padding:1px 8px; border-radius:6px; }
  .reason-input:focus{ outline:none; border-color:var(--accent); box-shadow:0 0 0 3px var(--accent-wash); }
  .reason-input.filled{ background:var(--accent-wash); border-color:var(--accent); }
  table.opart-table td, table.opart-table th{ padding-left:6px; padding-right:6px; }
  table.opart-table td:nth-child(2){ white-space:normal; max-width:160px; }
  tbody tr:last-child td{ border-bottom:none; }
  tbody tr{ transition:background .1s ease; }
  tbody tr:hover td{ background:var(--surface-2); }
  td.num, th.num{ text-align:right; font-family:var(--font-mono); font-variant-numeric:tabular-nums; }
  td.mono{ font-family:var(--font-mono); font-size:14.5px; }
  .aloistag{ display:inline-block; font-family:var(--font-mono); font-size:12.5px; font-weight:600; padding:2px 7px; border-radius:7px; background:var(--surface-2); color:var(--ink-2); }
  .subttl{ font-family:var(--font-display); font-weight:600; font-size:15px; text-transform:none; letter-spacing:0; color:var(--ink); margin:0 0 10px; display:flex; justify-content:space-between; }
  .subttl .n{ font-family:var(--font-mono); color:var(--muted); font-weight:500; text-transform:none; letter-spacing:0; }
  tbody tr.top1 td{ background:var(--accent-wash); }

  .grouphead td{ margin-top:12px; padding:10px 14px; border-bottom:none; border-radius:10px;
    background:var(--accent-wash); border:none;
    font-family:var(--font-body); font-weight:600; font-size:13px;
    text-transform:none; letter-spacing:0; color:var(--accent-strong); cursor:pointer; user-select:none; transition:filter .12s ease; }
  .grouphead:hover td{ filter:brightness(0.97); }
  .grouphead .caret{ display:inline-block; margin-right:8px; font-size:12px; font-weight:800; color:var(--accent); transition:transform .15s ease; }
  .grouphead.open .caret{ transform:rotate(90deg); }
  .grouphead .hint{ float:right; font-family:var(--font-mono); font-size:11px; text-transform:none; letter-spacing:0; color:var(--accent); opacity:.75; }
  .grouphead.open .hint::before{ content:"접기 ▲"; }
  .grouphead:not(.open) .hint::before{ content:"펼치기 ▾"; }
  tbody tr.grouphead:first-child td{ margin-top:0; }
  tbody tr.grouphead:hover td{ background:var(--accent-wash); }
  tbody tr.grouphead + tr td{ border-top:none; }
  tbody tr.subtotal td{ border-top:1px solid var(--line); border-bottom:1.5px solid var(--line); font-weight:700; }
  tbody tr.subtotal:hover td{ background:transparent; }
  td.num.neg{ color:var(--critical); }

  .aloistag.oseries{ background:var(--critical-wash); color:var(--critical); font-weight:700; }
  tbody tr.oseries td.num, tbody tr.oseries td.mono{ color:var(--critical); }
  tbody tr.subtotal.oseries td{ color:var(--critical); }
  .grouphead.oseries td{ background:var(--critical-wash); color:var(--critical); }
  .grouphead.oseries:hover td{ background:var(--critical-wash); }
  .grouphead.oseries .caret, .grouphead.oseries .hint{ color:var(--critical); }
  tr.cancelled{ opacity:.55; }
  .empty-note{ font-size:14.5px; color:var(--muted); padding:12px 4px; }

  .m-topbar, .m-backdrop{ display:none; }
  @media (max-width:900px){
    html, body{ height:auto; }
    .app{ display:block; height:auto; min-height:100vh; }
    .m-topbar{ display:flex; align-items:center; gap:6px; position:sticky; top:0; z-index:90; height:54px; padding:0 10px;
      background:var(--sidebar); box-shadow:0 1px 0 var(--line); }
    .m-btn{ all:unset; box-sizing:border-box; width:40px; height:40px; display:flex; align-items:center; justify-content:center;
      border-radius:10px; color:var(--ink-2); cursor:pointer; flex:none; }
    .m-btn:active{ background:var(--surface-2); }
    .m-title{ flex:1; min-width:0; font-weight:700; font-size:17px; letter-spacing:-.01em; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .sidebar{ position:fixed; top:0; left:0; bottom:0; width:280px; max-width:84vw; z-index:110; padding:18px 14px 28px; gap:18px;
      transform:translateX(-104%); transition:transform .22s ease; overflow-y:auto; box-shadow:none; }
    body.menu-open .sidebar{ transform:none; box-shadow:0 0 40px rgba(0,0,0,.28); }
    .m-backdrop{ position:fixed; inset:0; z-index:105; background:rgba(0,0,0,.38); }
    body.menu-open .m-backdrop{ display:block; }
    body.menu-open{ overflow:hidden; }
    .sb-tools{ display:none; }
    .sb-item{ font-size:15px; padding:10px 12px; }
    .main{ height:auto; overflow:visible; }
    .maininner{ padding:14px 12px 56px; gap:14px; }
    .crumb{ display:none; }
    .crumbbar{ flex-wrap:wrap; }
    .freshness{ font-size:12px; }
    .kpitile{ padding:14px 16px; }
    .kpitile .value{ font-size:26px; }
    .viewer{ padding:16px 12px; border-radius:16px; }
    .viewer-head .lbl{ font-size:17px; }
    table{ font-size:13.5px; }
    tbody td{ padding:8px 8px; }
    .grouphead td{ white-space:normal; line-height:1.5; }
  }
  @media (max-width:820px){
    .subgrid{ grid-template-columns:1fr; }
    .viewer-head .foot{ margin-left:0; width:100%; }
  }

  /* ============ 인쇄: 지금 보고 있는 화면만 깔끔하게 ============ */
  @media print{
    @page{ size:A4 landscape; margin:10mm; }
    html, body{ height:auto !important; background:#fff; }
    body{ font-size:11px; }
    .app{ display:block !important; height:auto !important; min-height:0 !important; }
    .sidebar, .m-topbar, .m-backdrop{ display:none !important; }
    .main{ display:block !important; height:auto !important; overflow:visible !important; }
    .maininner{ max-width:none !important; padding:0; gap:10px; display:block; }
    .maininner > section > *{ margin-bottom:10px; }
    .kpistrip{ gap:8px; }
    .kpitile{ box-shadow:none; border:1px solid #ddd; padding:8px 12px; border-radius:10px; }
    .kpitile:hover{ box-shadow:none; transform:none; }
    .kpitile .tapln{ display:none; }
    .kpitile .value{ font-size:20px; }
    .kpitile .eyebrow{ font-size:11.5px; }
    .kpitile .foot{ font-size:10.5px; }
    .crumb, .freshness{ font-size:11px; }
    .viewer{ box-shadow:none; border:1px solid #ddd; padding:10px 12px; border-radius:10px; }
    .viewer-head{ margin-bottom:8px; padding-bottom:8px; }
    .viewer-head .lbl{ font-size:14px; }
    .viewer-head .val{ font-size:14px; }
    .viewer-head .foot{ font-size:10.5px; }
    .tablewrap{ overflow:visible !important; }
    table{ font-size:10.5px; }
    thead{ display:table-header-group; }
    thead th{ font-size:10px; padding:0 5px 5px; white-space:normal; }
    tbody td{ padding:3px 5px; white-space:normal !important; }
    td.mono{ font-size:10px; }
    .aloistag{ font-size:9.5px; padding:1px 5px; }
    .reason-input{ width:100%; min-width:120px; border:none !important; background:transparent !important; padding:0; box-shadow:none !important; font-size:10.5px; }
    .reason-input::placeholder{ color:transparent; }
    .grouphead .hint{ display:none; }
    tr{ break-inside:avoid; page-break-inside:avoid; }
    tbody tr:hover td{ background:transparent; }
    .aloistag, .aloistag.oseries, .grouphead td, .grouphead.oseries td, .dday-cell, .subtotal td{ -webkit-print-color-adjust:exact; print-color-adjust:exact; }
    .kpitile[aria-pressed="true"]{ box-shadow:none; }
  }
</style>
</head>
<body>

{% macro alois_table(groups, cols, prefix) -%}
<table>
  <thead><tr>
    <th>ALOIS</th>
    {% if 'qty' in cols %}<th class="num">수량</th>{% endif %}
    <th class="num">{{ '재고금액' if 'pct' in cols else '구매금액' }}</th>
    {% if 'pct' in cols %}<th class="num">비중</th>{% endif %}
  </tr></thead>
  <tbody>
    {% for g in groups %}
    {% set gkey = prefix ~ '-' ~ loop.index %}
    <tr class="grouphead{{ ' oseries' if g.oseries else '' }}" data-group="{{ gkey }}" onclick="toggleAloisGroup(this)"><td colspan="{{ cols|length + 1 }}"><span class="caret">▸</span>{{ g.code }}<span class="hint"></span></td></tr>
    {% for r in g.rows %}
    <tr data-group="{{ gkey }}" hidden{{ ' class="oseries"'|safe if g.oseries else '' }}>
      <td><span class="aloistag{{ ' oseries' if g.oseries else '' }}">{{ r.code }}</span></td>
      {% if 'qty' in cols %}<td class="num">{{ '{:,}'.format(r.qty) }}</td>{% endif %}
      <td class="num">{{ '{:,}'.format(r.val) }}</td>
      {% if 'pct' in cols %}<td class="num">{{ '%.2f'|format(r.pct) }}%</td>{% endif %}
    </tr>
    {% endfor %}
    <tr class="subtotal{{ ' oseries' if g.oseries else '' }}">
      <td{% if 'qty' not in cols and 'pct' not in cols %} colspan="1"{% endif %}>{{ g.code }} 합계</td>
      {% if 'qty' in cols %}<td class="num">{{ '{:,}'.format(g.subtotal_qty) }}</td>{% endif %}
      <td class="num">{{ '{:,}'.format(g.subtotal_val) }}</td>
      {% if 'pct' in cols %}<td class="num">{{ '%.2f'|format(g.subtotal_pct) }}%</td>{% endif %}
    </tr>
    {% endfor %}
  </tbody>
</table>
{%- endmacro %}

<div class="app">

  <header class="m-topbar">
    <button class="m-btn" onclick="toggleMenu()" aria-label="메뉴 열기">
      <svg width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 6h16M3 11h16M3 16h16"/></svg>
    </button>
    <span class="m-title" id="m-title">오늘 현황</span>
    <button class="m-btn" onclick="window.print()" aria-label="현재 화면 인쇄">
      <svg width="20" height="20" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 6V2h8v4"/><rect x="2" y="6" width="14" height="7" rx="1.2"/><path d="M5 11h8v5H5z"/></svg>
    </button>
    <button class="m-btn" onclick="exportExcel()" aria-label="현재 화면 엑셀 저장">
      <svg width="20" height="20" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M9 2v9M5.5 8 9 11.5 12.5 8"/><path d="M3 12v3h12v-3"/></svg>
    </button>
  </header>
  <div class="m-backdrop" onclick="toggleMenu(false)"></div>

  <nav class="sidebar" aria-label="동성모터스 PARTS 메뉴">
    <div class="sb-brand" role="button" tabindex="0" onclick="selectPage('today')" onkeydown="if(event.key==='Enter'||event.key===' '){selectPage('today')}"><div class="mark">DS</div><span class="name">동성모터스 PARTS</span></div>
    <div class="sb-mstripe"></div>

    <div class="sb-workspace">
      <div class="ico"><svg width="14" height="14" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M9 2 2 5.5v7L9 16l7-3.5v-7L9 2Z"/><path d="M2 5.5 9 9l7-3.5"/><path d="M9 9v7"/></svg></div>
      <div class="tt"><b>{{ meta.branch_name }}</b></div>
    </div>

    <div class="sb-tools">
      <button class="sb-print" onclick="window.print()">
        <svg width="15" height="15" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 6V2h8v4"/><rect x="2" y="6" width="14" height="7" rx="1.2"/><path d="M5 11h8v5H5z"/></svg>
        현재 화면 인쇄
      </button>
      <button class="sb-print" onclick="exportExcel()">
        <svg width="15" height="15" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M9 2v9M5.5 8 9 11.5 12.5 8"/><path d="M3 12v3h12v-3"/></svg>
        현재 화면 엑셀 저장
      </button>
    </div>

    <div class="sb-section">
      <span class="sb-label">Workspace</span>
      <button class="sb-item" id="nav-today" aria-current="page" onclick="selectPage('today')">
        <svg width="16" height="16" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="2" y="2" width="6" height="6" rx="1"/><rect x="10" y="2" width="6" height="6" rx="1"/><rect x="2" y="10" width="6" height="6" rx="1"/><rect x="10" y="10" width="6" height="6" rx="1"/></svg>
        오늘 현황
      </button>
      <button class="sb-item" id="nav-external" aria-current="false" onclick="selectPage('external')">
        <svg width="16" height="16" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M2 3h2l1.6 8.4a1.5 1.5 0 0 0 1.5 1.2h5.6a1.5 1.5 0 0 0 1.5-1.2L15 6H5"/><circle cx="7" cy="15.5" r="1"/><circle cx="13" cy="15.5" r="1"/><path d="M13 2.5 15.5 5M15.5 2.5 13 5"/></svg>
        외부 판매 현황
      </button>
      <button class="sb-item" id="nav-longstock" aria-current="false" onclick="selectPage('longstock')">
        <svg width="16" height="16" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="9" cy="9" r="7"/><path d="M9 5v4l3 2"/></svg>
        장기 재고 현황
      </button>
      <button class="sb-item" id="nav-calendar" aria-current="false" onclick="selectPage('calendar')">
        <svg width="16" height="16" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="2" y="3" width="14" height="13" rx="1.5"/><path d="M2 7h14"/><path d="M6 2v3M12 2v3"/></svg>
        팀 캘린더
      </button>
    </div>

    <div class="sb-section">
      <span class="sb-label">KPI 관리</span>
      <button class="sb-item" id="nav-accessory" aria-current="false" onclick="selectPage('accessory')">
        <svg width="16" height="16" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="9" cy="9" r="7"/><circle cx="9" cy="9" r="2.4"/><path d="M9 2v2M9 14v2M2 9h2M14 9h2"/></svg>
        악세사리&amp;타이어
      </button>
    </div>

    <div class="sb-section">
      <span class="sb-label">진행 작업 관리</span>
      <button class="sb-item" id="nav-openro" aria-current="false" onclick="selectPage('openro')">
        <svg width="16" height="16" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="2" width="12" height="14" rx="1.5"/><path d="M6 6h6M6 9h6M6 12h3"/></svg>
        진행RO
      </button>
      <button class="sb-item" id="nav-noshow" aria-current="false" onclick="selectPage('noshow')">
        <svg width="16" height="16" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="9" cy="9" r="7"/><path d="M6 6l6 6M12 6l-6 6"/></svg>
        노쇼 SB부품
      </button>
    </div>

    <div class="sb-section">
      <span class="sb-label">O파트 관리</span>
      <button class="sb-item" id="nav-opart" aria-current="false" onclick="selectPage('opart')">
        <svg width="16" height="16" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 9h12M9 3v12"/><circle cx="9" cy="9" r="7"/></svg>
        O파트 PR현황
      </button>
      <button class="sb-item" id="nav-oflow" aria-current="false" onclick="selectPage('oflow')">
        <svg width="16" height="16" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 12 7 7l3 3 5-6"/><path d="M12 4h3v3"/></svg>
        O파트 입출고 내역
      </button>
      <button class="sb-item" id="nav-oaov" aria-current="false" onclick="selectPage('oaov')">
        <svg width="16" height="16" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M2 9a7 7 0 0 1 12-5"/><path d="M14 4v4h-4"/><path d="M16 9a7 7 0 0 1-12 5"/><path d="M4 14v-4h4"/></svg>
        OAOV 현황
      </button>
    </div>

    <div class="sb-spacer"></div>
    <div class="sb-foot">My DMS Console · {{ meta.generated_at }}</div>
  </nav>

  <main class="main">
    <div class="maininner">
    <section id="page-today">
      <div class="crumbbar">
        <span class="crumb">동성모터스 PARTS &nbsp;›&nbsp; <b>오늘 현황</b></span>
        <div class="spacer"></div>
        <div class="freshness"><span class="dot"></span>{{ meta.generated_at }}</div>
      </div>

      <div class="kpistrip">
        <button class="kpitile" id="tile-recv" onclick="selectKpi('recv')" aria-pressed="true">
          <span class="rank">01</span>
          <span class="eyebrow">오늘 입고금액</span>
          <span class="value">₩{{ '{:,}'.format(recv.total) }}</span>
          <span class="foot">{{ recv.date }} · GRN {{ recv.grn_count }}건 · {{ recv.lines }}라인</span>
          <span class="tapln">눌러서 세부내역 보기 ↓</span>
        </button>
        <button class="kpitile" id="tile-inv" onclick="selectKpi('inv')" aria-pressed="false">
          <span class="rank">02</span>
          <span class="eyebrow">재고금액 · 부품창고</span>
          <span class="value">₩{{ '{:,}'.format(inv.total) }}</span>
          <span class="foot">{{ inv.item_count }}품목 · {{ inv.code_count }}개 코드</span>
          <span class="tapln">눌러서 세부내역 보기 ↓</span>
        </button>
      </div>

      <div class="viewer">
        <div id="detail-recv">
          <div class="viewer-head">
            <span class="lbl">오늘 입고금액 세부</span>
            <span class="val">₩{{ '{:,}'.format(recv.total) }}</span>
            <span class="foot">{{ recv.qty }}개 · 전건 확정 · 부품창고</span>
          </div>
          <div class="subgrid">
            <div>
              <p class="subttl">ALOIS별 입고금액 <span class="n">A·L·O·I·S 그룹 · 코드 오름차순</span></p>
              <div class="tablewrap">{{ alois_table(recv.alois_groups, ['val'], 'recv') }}</div>
            </div>
            <div>
              <p class="subttl">GRN별 입고금액 <span class="n">{{ recv.grn_count }}건 · GRN 내림차순</span></p>
              <div class="tablewrap">
                <table>
                  <thead><tr><th>GRN</th><th class="num">구매금액</th></tr></thead>
                  <tbody>
                    {% for r in recv.grn_rows %}
                    <tr{{ ' class="top1"'|safe if r.is_top else '' }}><td class="mono">{{ r.grn }}</td><td class="num">{{ '{:,}'.format(r.val) }}</td></tr>
                    {% endfor %}
                  </tbody>
                </table>
              </div>
            </div>
          </div>
          <div>
            <p class="subttl">입고금액 TOP 5</p>
            <div class="tablewrap">
              <table>
                <thead><tr><th>부품번호</th><th>품명</th><th>ALOIS</th><th>GRN</th><th class="num">수량</th><th class="num">구매금액</th></tr></thead>
                <tbody>
                  {% for r in recv.top5 %}
                  <tr><td class="mono">{{ r.item }}</td><td>{{ r.name }}</td><td><span class="aloistag{{ ' oseries' if r.oseries else '' }}">{{ r.alois }}</span></td><td class="mono">{{ r.grn }}</td><td class="num">{{ r.qty }}</td><td class="num">{{ '{:,}'.format(r.val) }}</td></tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <div id="detail-inv" hidden>
          <div class="viewer-head">
            <span class="lbl">재고금액 세부</span>
            <span class="val">₩{{ '{:,}'.format(inv.total) }}</span>
            <span class="foot">{{ inv.item_count }}품목 · 부품창고</span>
          </div>
          <p class="subttl">ALOIS별 재고금액 <span class="n">A·L·O·I·S 그룹 · 코드 오름차순 · O계열 붉은색</span></p>
          <div class="tablewrap">{{ alois_table(inv.alois_groups, ['qty','val','pct'], 'inv') }}</div>
        </div>
      </div>
    </section>

    <section id="page-openro" hidden>
      <div class="crumbbar">
        <span class="crumb">동성모터스 PARTS &nbsp;›&nbsp; <b>진행RO</b></span>
        <div class="spacer"></div>
        <div class="freshness"><span class="dot"></span>{{ meta.branch_name }} · 인보이스 미완료 RO · RO발행일 오래된순</div>
      </div>

      <div class="kpistrip">
        <div class="kpitile" style="cursor:default">
          <span class="rank">01</span>
          <span class="eyebrow">진행 RO (인보이스 미완료)</span>
          <span class="value">{{ openro.count }}건</span>
          <span class="foot">금액 합계 ₩{{ '{:,}'.format(openro.total_amt) }} · 가장 오래된 RO {{ openro.oldest }}</span>
        </div>
        <div class="kpitile" style="cursor:default">
          <span class="rank">02</span>
          <span class="eyebrow">상태별 건수</span>
          <span class="foot" style="line-height:1.7">
            {% for s in openro.by_stat %}{{ s.stat }} <b>{{ s.count }}</b>{{ ' · ' if not loop.last else '' }}{% endfor %}
          </span>
        </div>
      </div>

      <div class="viewer">
        <div class="viewer-head">
          <span class="lbl">진행 RO 리스트</span>
          <span class="val">{{ openro.count }}건</span>
          <span class="foot">금액 = 부품+공임 판매가 · 사유는 입력하면 이 브라우저에 자동 저장돼 계속 표시됩니다</span>
        </div>
        <div class="tablewrap">
          <table class="openro-table">
            <thead><tr><th>RO번호</th><th>서비스유형</th><th>SA</th><th>RO상태</th><th>발행일</th><th>경과일</th><th class="num">금액</th><th>사유</th></tr></thead>
            <tbody>
              {% for r in openro.rows %}
              <tr>
                <td class="mono">{{ r.ro }}</td><td>{{ r.svc }}</td><td>{{ r.sa }}</td>
                <td><span class="aloistag">{{ r.stat }}</span></td>
                <td class="mono">{{ r.pub }}</td><td class="mono dday-cell" data-days="{{ r.dday[2:-1] }}">{{ r.dday }}</td>
                <td class="num">{{ '{:,}'.format(r.amt) }}</td>
                <td><input class="reason-input" type="text" data-ro="{{ r.ro }}" placeholder="사유 입력" autocomplete="off"></td>
              </tr>
              {% else %}
              <tr><td colspan="8" class="empty-note">진행 중인 RO 없음</td></tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section id="page-noshow" hidden>
      <div class="crumbbar">
        <span class="crumb">동성모터스 PARTS &nbsp;›&nbsp; <b>노쇼 SB부품</b></span>
        <div class="spacer"></div>
        <div class="freshness"><span class="dot"></span>{{ meta.branch_name }} · 노쇼 SB에 남아있는 미처리 부품요청 · 예약일 오래된순</div>
      </div>

      <div class="kpistrip">
        <div class="kpitile" style="cursor:default">
          <span class="rank">01</span>
          <span class="eyebrow">노쇼인데 부품이 남은 SB</span>
          <span class="value">{{ noshow.sb_count }}건</span>
          <span class="foot">{{ noshow.line_count }}라인 · 요청수량×원가 합계 ₩{{ '{:,}'.format(noshow.total_val) }}</span>
        </div>
        <div class="kpitile" style="cursor:default">
          <span class="rank">02</span>
          <span class="eyebrow">그 중 O계열 부품</span>
          <span class="value">₩{{ '{:,}'.format(noshow.o_val) }}</span>
          <span class="foot">{{ noshow.o_lines }}라인 (원가 기준)</span>
        </div>
      </div>

      <div class="viewer">
        <div class="viewer-head">
          <span class="lbl">노쇼 SB별 부품 세부</span>
          <span class="val">{{ noshow.sb_count }}건</span>
          <span class="foot">SB 클릭해서 펼치기 · 서비스예약현황 노쇼 {{ noshow.noshow_total }}건 중 미처리 부품요청이 남은 SB</span>
        </div>
        <div class="tablewrap">
          <table>
            <thead><tr><th>부품번호</th><th>품명</th><th>ALOIS</th><th class="num">요청수량</th><th class="num">현재고</th><th class="num">가용재고</th><th class="num">원가금액</th></tr></thead>
            <tbody>
              {% for g in noshow.groups %}
              <tr class="grouphead open" data-group="ns-{{ g.code }}" onclick="toggleAloisGroup(this)"><td colspan="7"><span class="caret">▸</span>{{ g.code }} · 예약일 {{ g.resv }} · <span class="dday-cell dday-badge"{% if g.dday.startswith('D+') %} data-days="{{ g.dday[2:-1] }}"{% endif %}>{{ g.dday }}</span> · SA {{ g.sa }} ({{ g.count }}라인)<span class="hint"></span></td></tr>
              {% for r in g.rows %}
              <tr data-group="ns-{{ g.code }}"><td class="mono">{{ r.item }}</td><td>{{ r.name }}</td><td><span class="aloistag{{ ' oseries' if r.alois and r.alois.startswith('O') else '' }}">{{ r.alois }}</span></td><td class="num">{{ r.req_qty }}</td><td class="num">{{ r.crt_qty }}</td><td class="num">{{ r.avail_qty }}</td><td class="num">{{ '{:,}'.format(r.val) }}</td></tr>
              {% endfor %}
              <tr class="subtotal"><td colspan="3">{{ g.code }} 합계</td><td class="num">{{ g.qty_sum }}</td><td class="num"></td><td class="num"></td><td class="num">{{ '{:,}'.format(g.val) }}</td></tr>
              {% else %}
              <tr><td colspan="7" class="empty-note">노쇼 SB에 남은 미처리 부품요청 없음</td></tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section id="page-external" hidden>
      <div class="crumbbar">
        <span class="crumb">동성모터스 PARTS &nbsp;›&nbsp; <b>외부 판매 현황</b></span>
        <div class="spacer"></div>
        <div class="freshness"><span class="dot"></span>{{ meta.branch_name }} · {{ ext.period }} · 당월 누계</div>
      </div>

      <div class="kpistrip">
        <button class="kpitile" id="tile-ext" onclick="selectExtKpi('ext')" aria-pressed="true">
          <span class="rank">01</span>
          <span class="eyebrow">외부 · 인보이스금액</span>
          <span class="value">₩{{ '{:,}'.format(ext.total) }}</span>
          <span class="foot">원가(품목원가합계) ₩{{ '{:,}'.format(ext.cost) }} · 유효 {{ ext.valid_count }}건{% if ext.cancelled_count %}(취소 {{ ext.cancelled_count }}건 제외){% endif %} · {{ ext.lines }}라인</span>
          <span class="tapln">눌러서 세부내역 보기 ↓</span>
        </button>
        <button class="kpitile" id="tile-shop" onclick="selectExtKpi('shop')" aria-pressed="false">
          <span class="rank">02</span>
          <span class="eyebrow">외부공업사 · 인보이스금액</span>
          <span class="value">₩{{ '{:,}'.format(shop.total) }}</span>
          <span class="foot">{{ shop.foot_note }}</span>
          <span class="tapln">눌러서 세부내역 보기 ↓</span>
        </button>
      </div>

      <div class="viewer">
        <div id="detail-ext">
          <div class="viewer-head">
            <span class="lbl">외부 세부 (C고객 · 정산상세유형 = 외부)</span>
            <span class="val">₩{{ '{:,}'.format(ext.total) }}</span>
            <span class="foot">원가(품목원가합계) ₩{{ '{:,}'.format(ext.cost) }} · 마진(DMS 산출) ₩{{ '{:,}'.format(ext.margin) }}</span>
          </div>
          <p class="subttl">인보이스 전체 <span class="n">최신일순 · 유효 {{ ext.valid_count }}건</span></p>
          <div class="tablewrap">
            <table>
              <thead><tr><th>부품판매번호</th><th>인보이스번호</th><th>거래처</th><th>일자</th><th class="num">인보이스금액</th><th class="num">원가</th></tr></thead>
              <tbody>
                {% for r in ext.top5 %}
                <tr><td class="mono">{{ r.num }}</td><td class="mono">{{ r.inv }}</td><td>{{ r.cust }}</td><td class="mono">{{ r.dt }}</td><td class="num">{{ '{:,}'.format(r.amt) }}</td><td class="num">{{ '{:,}'.format(r.cost) }}</td></tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>

        <div id="detail-shop" hidden>
          <div class="viewer-head">
            <span class="lbl">외부공업사 세부 (C고객 · 정산상세유형 = 외부공업사)</span>
            <span class="val">₩{{ '{:,}'.format(shop.total) }}</span>
            <span class="foot">{{ shop.foot_note }}</span>
          </div>
          <p class="subttl">인보이스 <span class="n">전체 {{ shop.invoices|length }}건</span></p>
          <div class="tablewrap">
            <table>
              <thead><tr><th>부품판매번호</th><th>인보이스번호</th><th>거래처</th><th>일자</th><th class="num">인보이스금액</th><th class="num">원가</th><th>상태</th></tr></thead>
              <tbody>
                {% for r in shop.invoices %}
                <tr{{ ' class="cancelled"'|safe if r.cancelled else '' }}><td class="mono">{{ r.num }}</td><td class="mono">{{ r.inv }}</td><td>{{ r.cust }}</td><td class="mono">{{ r.dt }}</td><td class="num">{{ '{:,}'.format(r.amt) }}</td><td class="num">{{ '{:,}'.format(r.cost) }}</td><td>{{ r.status }}</td></tr>
                {% else %}
                <tr><td colspan="7" class="empty-note">이번 달 외부공업사 인보이스 없음</td></tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>

        <div style="margin-top:18px; padding-top:14px; border-top:1px solid var(--line); display:flex; gap:24px; flex-wrap:wrap;">
          <div><span class="subttl" style="margin:0">외부+외부공업사 합계</span></div>
          <div style="display:flex; gap:24px; flex-wrap:wrap; font-family:var(--font-mono); font-size:16px;">
            <span>인보이스금액 <b>₩{{ '{:,}'.format(ext.total + shop.total) }}</b></span>
            <span>원가 <b>₩{{ '{:,}'.format(ext.cost + shop.cost) }}</b></span>
            <span>유효 인보이스 <b>{{ ext.valid_count + shop.valid_count }}건</b> · <b>{{ ext.lines + shop.lines }}라인</b></span>
          </div>
        </div>
      </div>
    </section>

    <section id="page-accessory" hidden>
      <div class="crumbbar">
        <span class="crumb">동성모터스 PARTS &nbsp;›&nbsp; <b>악세사리&amp;타이어</b></span>
        <div class="spacer"></div>
        <div class="freshness"><span class="dot"></span>{{ meta.branch_name }} · 정산유형 C+I · {{ ext.period }}</div>
